# Compagni di Viaggi - Environment Variables Example
# Copy this file to .env and update with your values

# Database Configuration
DB_HOST=localhost
DB_NAME=compagni_di_viaggi
DB_USER=your_database_user
DB_PASS=your_database_password

# Site Configuration (optional - auto-detected if not set)
# For production: SITE_URL=https://www.compagnidiviaggi.com
# For local dev: SITE_URL=http://localhost:8000
SITE_URL=https://www.compagnidiviaggi.com

# Environment (development or production)
ENVIRONMENT=production

# Security (generate a random string for production)
SESSION_SECRET=your_random_session_secret_here

# Email Configuration (for future features)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password

# Upload Settings
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg
